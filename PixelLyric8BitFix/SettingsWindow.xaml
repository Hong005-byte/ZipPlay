<Window x:Class="PixelLyric8BitFix.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay — 启动设置" Height="600" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1B1B1B">

    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#55FF55"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- 皮肤卡片：预览框（用 Background/BorderBrush 表现每套皮肤自己的配色） + 名字 + 选中态勾选角标 -->
        <Style x:Key="SkinCardStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="122"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="#3A3A3A" Background="#141414">
                                <StackPanel Margin="6">
                                    <!-- 预览框：不只是一块纯色，而是用当前皮肤的配色画出"标题条 + 进度条 + 歌词框"的迷你线框图，
                                         大致还原真实播放器的样子。Background/BorderBrush 由每张卡片各自的皮肤配色提供。 -->
                                    <Border Height="42" CornerRadius="6"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1.5"
                                            ClipToBounds="True">
                                        <Grid Margin="7,5,7,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <!-- 迷你"标题"条 -->
                                            <Border Grid.Row="0" Height="3" Width="38" HorizontalAlignment="Left" CornerRadius="1.5"
                                                    Background="{TemplateBinding BorderBrush}" Opacity="0.9"/>

                                            <!-- 迷你"进度条" -->
                                            <Grid Grid.Row="1" Margin="0,4,0,3">
                                                <Border Height="2.5" CornerRadius="1.5" Background="#40000000"/>
                                                <Border Height="2.5" Width="24" HorizontalAlignment="Left" CornerRadius="1.5"
                                                        Background="{TemplateBinding BorderBrush}"/>
                                            </Grid>

                                            <!-- 迷你"歌词框" -->
                                            <Border Grid.Row="2" CornerRadius="3" Background="#40000000"
                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.75">
                                                <Border Width="30" Height="2.5" CornerRadius="1.5"
                                                        Background="{TemplateBinding BorderBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="Check" Width="20" Height="20" CornerRadius="10" Background="#55FF55"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-6,-6,0,0"
                                    Visibility="Collapsed">
                                <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="Black"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#55FF55"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#777777"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SkinCardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ZipPlay" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="小型歌词播放器 · 先选好样式和尺寸再启动" Foreground="#999999" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="皮肤风格" Style="{StaticResource SectionHeader}"/>
                <WrapPanel x:Name="SkinPanel">

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Minecraft" IsChecked="True">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#8B6239" Offset="0"/>
                                <GradientStop Color="#5C4025" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#4D9244"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🧱 Minecraft" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Simple">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#262626" Offset="0"/>
                                <GradientStop Color="#1A1A1A" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#3A3A3A"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="▬ 简约风" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Crt">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0A1F0A" Offset="0"/>
                                <GradientStop Color="#020602" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#33FF66"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="📺 CRT 终端" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Cyberpunk">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A0B2E" Offset="0"/>
                                <GradientStop Color="#0F0C29" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#00F0FF"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🌆 赛博朋克" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Vinyl">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A2A1E" Offset="0"/>
                                <GradientStop Color="#241811" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#C9A227"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="💿 黑胶唱片" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Glass">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3A3F4A" Offset="0"/>
                                <GradientStop Color="#22262E" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#B3FFFFFF"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🧊 玻璃拟态" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Lofi">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2E2118" Offset="0"/>
                                <GradientStop Color="#1C140D" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#C89666"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="☕ 复古咖啡馆" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Aurora">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B1E2D" Offset="0"/>
                                <GradientStop Color="#123B33" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#4FD8C4"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🌙 极光雪夜" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Rain">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1A2530" Offset="0"/>
                                <GradientStop Color="#0D1318" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#4A6572"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🌧️ 雨夜窗景" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Starry">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0A0E27" Offset="0"/>
                                <GradientStop Color="#050711" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#6B7FD7"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="✨ 星空太空" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Campfire">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#1A2818" Offset="0"/>
                                <GradientStop Color="#12180F" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#D97B36"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🏕️ 篝火露营" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Sakura">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3D2A3D" Offset="0"/>
                                <GradientStop Color="#241826" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#F7A8C4"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🌸 樱花" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Cassette">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#D9C9A8" Offset="0"/>
                                <GradientStop Color="#B8A488" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#8A6A4A"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="📼 复古磁带" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Cloud">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#AEE1F2" Offset="0"/>
                                <GradientStop Color="#7FB8DE" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#FFFFFF"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="☁️ 云朵漂浮" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Candle">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2A2018" Offset="0"/>
                                <GradientStop Color="#1A140E" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#D9A648"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🕯️ 烛光冥想" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Plant">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#3E2F22" Offset="0"/>
                                <GradientStop Color="#2A1F16" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#7FA66B"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🪴 绿植角落" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SkinCardStyle}" GroupName="Skin" Tag="Sunset">
                        <RadioButton.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#F2994A" Offset="0"/>
                                <GradientStop Color="#EA7093" Offset="0.45"/>
                                <GradientStop Color="#4A3B78" Offset="1"/>
                            </LinearGradientBrush>
                        </RadioButton.Background>
                        <RadioButton.BorderBrush>
                            <SolidColorBrush Color="#F9C784"/>
                        </RadioButton.BorderBrush>
                        <TextBlock Text="🌊 海边黄昏" Style="{StaticResource SkinCardLabelStyle}"/>
                    </RadioButton>

                </WrapPanel>

                <Button x:Name="BtnManageCustomThemes" Content="🎨 自定义主题…" Click="BtnManageCustomThemes_Click"
                        Padding="10,4" FontSize="11" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="不是代码，是纯数据——填颜色/渐变/像素图标，挑一种内置动画，最多能存 5 个。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="窗口尺寸" Style="{StaticResource SectionHeader}"/>
                <RadioButton x:Name="RbSizeSmall" Content="小　（400 × 170）" GroupName="Size"/>
                <RadioButton x:Name="RbSizeMedium" Content="中　（580 × 260）" GroupName="Size" IsChecked="True"/>
                <RadioButton x:Name="RbSizeLarge" Content="大　（760 × 340）" GroupName="Size"/>
                <TextBlock Text="选定后主窗口会锁定该尺寸，不能再拖拽缩放，避免误拉成全屏。" Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="显示模式" Style="{StaticResource SectionHeader}"/>
                <RadioButton x:Name="RbModeStandard" Content="标准（标题 + 进度条 + 歌词）" GroupName="Mode" IsChecked="True"/>
                <RadioButton x:Name="RbModeMinimal" Content="极简（只显示当前歌词）" GroupName="Mode"/>

                <TextBlock Text="歌词字号" Style="{StaticResource SectionHeader}"/>
                <RadioButton x:Name="RbFontSmall" Content="小" GroupName="FontSize"/>
                <RadioButton x:Name="RbFontMedium" Content="中（默认）" GroupName="FontSize" IsChecked="True"/>
                <RadioButton x:Name="RbFontLarge" Content="大" GroupName="FontSize"/>

                <TextBlock Text="Mini 模式律动效果" Style="{StaticResource SectionHeader}"/>
                <CheckBox x:Name="ChkMiniVisualizerEnabled" Content="开启（双击窗口缩成小方块时，周围会有像素粒子跟着系统音频跳动）"
                          Foreground="#CCCCCC" FontSize="11" IsChecked="True"/>
                <TextBlock Text="纯本地实时分析系统正在播放的声音，不联网、不录制、不保存任何音频数据；关掉这个开关后 Mini 模式下完全不会启动音频采集。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <TextBlock Text="灵敏度" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,2"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="RbVisualizerLow" Content="低" GroupName="VisualizerSensitivity" Margin="0,0,14,0"/>
                    <RadioButton x:Name="RbVisualizerMedium" Content="中（默认）" GroupName="VisualizerSensitivity" IsChecked="True" Margin="0,0,14,0"/>
                    <RadioButton x:Name="RbVisualizerHigh" Content="高" GroupName="VisualizerSensitivity"/>
                </StackPanel>
                <TextBlock Text="每个人电脑的系统音量、常听的音乐类型都不一样，觉得粒子太安静/太吵可以自己调这一档。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="想改皮肤不用重启程序：主播放器窗口里右键 →「更改皮肤 / 设置」随时能回到这一页。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                <TextBlock Text="全局快捷键：Ctrl + Alt + L 随时显示/隐藏播放器，就算窗口被其它程序挡住或者已经收进系统托盘也能用。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="左上角齿轮旁边有个 🎤 小开关，能关掉卡拉OK扫光效果，退回最早那种整行一次性切换的显示方式。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="旁边还有个 🌐 双语歌词开关：只有网易云那个引擎抓到翻译的歌才会显示翻译行，不是每首歌都有。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="关于" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtCurrentVersion" Text="当前版本 v1.0.0" Foreground="#999999" FontSize="11" VerticalAlignment="Center"/>
                    <Button x:Name="BtnCheckUpdate" Content="检查更新" Click="BtnCheckUpdate_Click"
                            Margin="10,0,0,0" Padding="10,3" FontSize="11"
                            Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <TextBlock x:Name="TxtUpdateStatus" Text="" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="Collapsed" MouseLeftButtonDown="TxtUpdateStatus_MouseLeftButtonDown"/>

                <TextBlock Text="本地缓存" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtCacheInfo" Text="暂无缓存" Foreground="#999999" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnOpenCacheFolder" Content="打开缓存文件夹" Click="BtnOpenCacheFolder_Click"
                            Padding="10,3" FontSize="11"
                            Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    <Button x:Name="BtnClearCache" Content="清空歌词缓存" Click="BtnClearCache_Click"
                            Margin="8,0,0,0" Padding="10,3" FontSize="11"
                            Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
                <TextBlock Text="抓到过的歌词会存一份在本地（每首歌一个 .lrc 文件），同一首歌下次再播就不用重新联网抓词。不放心的话可以先点「打开缓存文件夹」自己看一眼里面只有歌词文件；「清空」也只会删这一个文件夹里的内容，不会碰到其它设置，清空后不影响正常使用，只是下次播到的歌要重新抓一遍。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="诊断" Style="{StaticResource SectionHeader}"/>
                <Button x:Name="BtnOpenLog" Content="打开日志文件" Click="BtnOpenLog_Click"
                        Padding="10,3" FontSize="11" HorizontalAlignment="Left"
                        Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="遇到问题（崩溃、托盘图标不出现、热键不生效之类）时，这个文件里可能记了点线索，反馈问题时可以带上它。正常使用不影响，最多占 1MB 空间。"
                           Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <CheckBox x:Name="ChkSkipStartupSettings" Content="下次启动跳过这个页面，直接用当前选择进入播放器"
                      Foreground="#AAAAAA" FontSize="11" Margin="0,14,0,0" IsChecked="True"/>
            <TextBlock Text="想改皮肤/设置随时能从主播放器窗口右键菜单或者齿轮图标回来，不会因为跳过这一页就找不到入口。"
                       Foreground="#777777" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>

            <Button x:Name="BtnStart" Content="开始播放 ▶" Click="BtnStart_Click"
                    Height="38" Margin="0,10,0,0" FontWeight="Bold" FontSize="14"
                    Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
