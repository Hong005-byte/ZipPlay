<Window x:Class="PixelLyric8BitFix.ListeningHighlightsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay — 亮点回顾" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="✨ 听歌亮点回顾" Foreground="#F2F5F1" FontSize="20" FontWeight="Bold"/>

        <!-- 一张卡片一件事：图标 + 大字标题 + 一句小字说明，点"下一张"往后翻——跟满屏数字并排的
             统计页是同一份数据，只是换一种"一次只看一件事"的呈现方式，见 ListeningHighlightsBuilder。 -->
        <Border Grid.Row="1" x:Name="SlideCard" Margin="0,14,0,14" CornerRadius="10" BorderThickness="2" Padding="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtSlideIcon" FontSize="56" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtSlideHeadline" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"/>
                <TextBlock x:Name="TxtSlideSubtext" Foreground="#93A296" FontSize="13" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnPrev" Content="← 上一张" Click="BtnPrev_Click"
                    Style="{StaticResource PillButtonStyle}" Padding="12,6" FontSize="12"/>
            <TextBlock Grid.Column="1" x:Name="TxtSlideIndicator" Text="1 / 1" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Grid.Column="2" x:Name="BtnNext" Content="下一张 →" Click="BtnNext_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" FontSize="12" FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
