<Window x:Class="PixelLyric8BitFix.ListeningStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay — 听歌统计" Height="620" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <!-- SectionHeader 不再在这个窗口自己定义了，套的是 App.xaml 里那份全局共享样式 -->
    <Window.Resources>
        <!-- 本月/今年/全部时间 那几个切换按钮：选中的那个跟其它内置窗口的"强调色"保持一致（翡翠绿），
             没选中的是跟背景差不多的暗色卡片，一眼能看出当前在看哪个范围 -->
        <Style TargetType="RadioButton" x:Key="PeriodToggle">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D7E0D8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#1B211C" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#163B2C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                                <Setter Property="Foreground" Value="#6EE7B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="📊 听歌统计" Foreground="#F2F5F1" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="纯本地记录，不联网、不上传——数据存在这台电脑上，跟设置文件一个待遇" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton x:Name="RbPeriodMonth" Content="本月" GroupName="Period" Style="{StaticResource PeriodToggle}" IsChecked="True" Checked="Period_Checked"/>
                <RadioButton x:Name="RbPeriodYear" Content="今年" GroupName="Period" Style="{StaticResource PeriodToggle}" Checked="Period_Checked"/>
                <RadioButton x:Name="RbPeriodAll" Content="全部时间" GroupName="Period" Style="{StaticResource PeriodToggle}" Checked="Period_Checked"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock x:Name="TxtEmptyState" Text="这段时间还没有听歌记录——播放的时候程序会自动累计，回来再看看。"
                           Foreground="{StaticResource HintTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0" Visibility="Collapsed"/>

                <!-- 固定显示"今年 1 月 1 日到今天"，不跟着上面本月/今年/全部时间那三个切换按钮走——
                     热力图看的是"一年里哪几天听得多"，样式跟"选了哪个统计范围"是两件事；也不放进下面
                     SummaryPanel 里，那个面板会在"选中范围没有任何数据"时整块收起（比如刚进新的一个月），
                     但今年其它月份可能还有数据，热力图不该跟着一起消失。没有任何记录的一年就是格子全灰，
                     这本身就是一种"空状态"，不需要额外收起。见 ListeningStatsWindow.xaml.cs 的 BuildHeatmap。 -->
                <TextBlock Text="🔥 听歌热力图" Style="{StaticResource SectionHeader}"/>
                <Border Background="#1B211C" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="HeatmapCanvas" Height="60"/>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="TxtHeatmapHint" Text="" Foreground="{StaticResource HintTextBrush}" FontSize="10" Margin="0,0,0,10"/>

                <!-- 称号：按累计听歌时长（全部时间）现算的一个连续等级，跟热力图一样不跟着上面
                     本月/今年/全部时间三个切换按钮走——称号看的是"整体攒了多少"，不是某一段范围。
                     见 ListeningStatsWindow.xaml.cs 的 BuildRank、ListeningRank.cs。 -->
                <TextBlock Text="🎖️ 称号" Style="{StaticResource SectionHeader}"/>
                <Border Background="#1B211C" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,4,0,10">
                    <StackPanel>
                        <TextBlock x:Name="TxtRankName" Text="🌱 初来乍到" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold"/>
                        <!-- 用 Grid 两列 Star 权重实现进度条，不是真的 ProgressBar 控件——WPF 默认 ProgressBar
                             模板改色很麻烦（跟 CmbCardStyle 那边不用暗色 ComboBox 皮肤是同一个取舍），
                             两列 Star 宽度按 (进度, 1-进度) 分配是最简单能拿到一条纯色细长条的办法 -->
                        <Grid Height="6" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="RankProgressFillCol" Width="0*"/>
                                <ColumnDefinition x:Name="RankProgressEmptyCol" Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#12160F" CornerRadius="3" Grid.ColumnSpan="2"/>
                            <Border x:Name="RankProgressFill" Background="{StaticResource AccentBrush}" CornerRadius="3" Grid.Column="0"/>
                        </Grid>
                        <TextBlock x:Name="TxtRankNextHint" Text="" Foreground="{StaticResource HintTextBrush}" FontSize="10" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="SummaryPanel">
                    <Border Background="#1B211C" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock x:Name="TxtTotalTime" Text="0 小时 0 分钟" Foreground="{StaticResource AccentBrush}" FontSize="28" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtActiveDays" Text="0 天有听歌" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0"/>
                            <!-- 总结叙事：连续天数/不同艺人歌曲数/最投入的一天拼成一两句话，比单独几个
                                 并排的数字更有"讲故事"的感觉——数据太单薄（只有一两天记录）的时候
                                 ListeningStatsNarrative.BuildHeadline 会返回 null，这一行就整个收起来，
                                 不会硬凑一句没什么信息量的话 -->
                            <TextBlock x:Name="TxtNarrative" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                            <!-- 同一份 ListeningSummary 换一种"一次只看一件事、点下一张翻页"的呈现方式，
                                 跟上面这一段总结叙事不是互相替代，两个入口都留着——见 ListeningHighlightsBuilder。 -->
                            <Button x:Name="BtnHighlights" Content="✨ 查看亮点回顾" Style="{StaticResource PillButtonStyle}"
                                    HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0,12,0,0" Click="BtnHighlights_Click"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="🎤 最常听的艺人" Style="{StaticResource SectionHeader}"/>
                    <StackPanel x:Name="ArtistListPanel"/>
                    <TextBlock x:Name="TxtNoArtists" Text="暂无数据" Foreground="{StaticResource HintTextBrush}" FontSize="11" Visibility="Collapsed"/>

                    <TextBlock Text="🎵 最常听的歌曲" Style="{StaticResource SectionHeader}"/>
                    <StackPanel x:Name="TrackListPanel"/>
                    <TextBlock x:Name="TxtNoTracks" Text="暂无数据" Foreground="{StaticResource HintTextBrush}" FontSize="11" Visibility="Collapsed"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="卡片风格" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                <!-- 不强行给 ComboBox 套暗色皮肤——WPF 默认 ComboBox 控件模板比较复杂，只改 Background/
                     Foreground 容易出现"关闭状态改了、下拉列表那层没改到"这种深浅不一的半吊子效果，
                     不如干脆用系统默认的浅色下拉框，跟旁边深色背景稍微不搭但至少肯定看得清 -->
                <ComboBox Grid.Column="1" x:Name="CmbCardStyle" Margin="8,0,0,0" FontSize="11"/>
            </Grid>
            <TextBlock Text="分享卡片用这套主题的配色和图标，不影响你现在正在用的皮肤——挑个好看的就行，跟当前播放器用的是不是同一套没关系。"
                       Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnBack" Content="← 返回首页" Click="BtnBack_Click"
                        Style="{StaticResource PillButtonStyle}"
                        Height="38" HorizontalAlignment="Left" Padding="16,0" FontSize="13"/>
                <Button Grid.Column="1" x:Name="BtnSaveCard" Content="💾 保存分享卡片" Click="BtnSaveCard_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38" HorizontalAlignment="Right" Padding="16,0" FontWeight="Bold" FontSize="13"/>
                <Button Grid.Column="2" x:Name="BtnClearStats" Content="🗑 清空统计数据" Click="BtnClearStats_Click"
                        Style="{StaticResource DangerPillButtonStyle}"
                        Height="38" Margin="8,0,0,0" Padding="16,0" FontSize="12"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
