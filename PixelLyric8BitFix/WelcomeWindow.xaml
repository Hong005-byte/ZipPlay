<Window x:Class="PixelLyric8BitFix.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay" Height="560" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#12160F">
    <!-- Background 上面这个纯色只是没加载完资源字典之前的兜底；Window 自己的属性会在自己的
         Window.Resources 填好之前就解析，所以真正的渐变色放在 Grid 最底下那层 Border 里，
         不能直接写在 Window 的 Background 特性上（同一个元素身上这么用 StaticResource 会在启动时崩掉）。 -->

    <!-- 翡翠绿高级感这套配色/按钮样式现在是 app 级别共享的（见 App.xaml），跟 HomeWindow 用的是
         同一份，不在这个窗口自己的 Resources 里重复定义了 -->

    <Grid>
        <Border Background="{StaticResource WindowBackgroundBrush}"/>

        <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TxtTitle" Text="👋 欢迎使用 ZipPlay" Foreground="#F2F5F1" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TxtSubtitle" Text="先告诉我们怎么称呼你吧——之后分享听歌报告的时候会用上，不填也没关系"
                       Foreground="#93A296" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Rectangle Height="3" Width="36" HorizontalAlignment="Left" Margin="0,10,0,0"
                       Fill="{StaticResource AccentBarBrush}" RadiusX="1.5" RadiusY="1.5"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center">

                <!-- 头像圆圈：圆圈本身就能点直接换头像（跟 HomeWindow 头像入口的手感一致），
                     ImageBrush 初始是空的（没有头像时），圆圈本身的描边 + 中间的占位 emoji
                     就是"还没设头像"的样子；选完图之后直接把 AvatarBrush.ImageSource 换掉，占位 emoji 相应隐藏 -->
                <Grid x:Name="AvatarClickArea" HorizontalAlignment="Center" Width="88" Height="88" Margin="0,4,0,10"
                      Cursor="Hand" MouseLeftButtonDown="AvatarClickArea_MouseLeftButtonDown">
                    <Ellipse Width="88" Height="88" Style="{StaticResource AvatarRingStyle}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#34D399" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
                        </Ellipse.Effect>
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="TxtAvatarPlaceholder" Text="👤" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Button x:Name="BtnChooseAvatar" Content="更换头像" Click="BtnChooseAvatar_Click"
                            Style="{StaticResource PillButtonStyle}"
                            Padding="10,3" FontSize="11" Margin="0,0,6,0"/>
                    <Button x:Name="BtnRemoveAvatar" Content="移除" Click="BtnRemoveAvatar_Click"
                            Style="{StaticResource DangerPillButtonStyle}"
                            Padding="10,3" FontSize="11"/>
                </StackPanel>

                <Grid>
                    <TextBox x:Name="TxtName" FontSize="16" Padding="10,8"
                             Background="#161C17" Foreground="#F2F5F1" BorderBrush="#2A332B" BorderThickness="1"
                             CaretBrush="#34D399" MaxLength="20"
                             TextChanged="TxtName_TextChanged" KeyDown="TxtName_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#34D399"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock x:Name="TxtNamePlaceholder" Text="给自己起个昵称吧" Foreground="#4A5A4C" FontSize="16"
                               Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <TextBlock Text="名字、头像纯本地存着，不会传到任何地方，随时能改。" Foreground="#5C6B5E" FontSize="10" Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="BtnExportProfile" Content="📤 导出个人资料" Click="BtnExportProfile_Click"
                            Style="{StaticResource PillButtonStyle}"
                            Padding="10,3" FontSize="11" Margin="0,0,8,0"/>
                    <Button x:Name="BtnImportProfile" Content="📥 导入个人资料" Click="BtnImportProfile_Click"
                            Style="{StaticResource PillButtonStyle}"
                            Padding="10,3" FontSize="11"/>
                </StackPanel>
                <TextBlock Text="名字、头像、听歌记录会打包成一个文件；换电脑或者重装之后导入这份文件就能接着用，不用从头再来。"
                           Foreground="#5C6B5E" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="TxtProfileStatus" Text="" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>

                <!-- 导入不会一选完文件就直接覆盖本地数据——先弹这条内嵌确认，点了"确定导入"才真的动手，
                     避免手滑选错文件把本地攒的听歌记录冲掉 -->
                <Border x:Name="PanelImportConfirm" Visibility="Collapsed" Margin="0,8,0,0"
                        Background="#221D14" BorderBrush="#D8B26B" BorderThickness="1" CornerRadius="8" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="⚠ 导入会覆盖本地的名字、头像、听歌记录，确定要继续吗？"
                                   Foreground="#D8B26B" FontSize="10.5" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BtnConfirmImport" Content="确定导入" Click="BtnConfirmImport_Click"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="12,4" FontSize="11"/>
                            <Button x:Name="BtnCancelImport" Content="取消" Click="BtnCancelImport_Click"
                                    Style="{StaticResource PillButtonStyle}" Padding="12,4" FontSize="11" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" Padding="16,0" FontSize="13" Visibility="Collapsed"/>
            <Button Grid.Column="1" x:Name="BtnContinue" Content="开始使用 →" Click="BtnContinue_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="38" HorizontalAlignment="Right" Padding="18,0" FontWeight="Bold" FontSize="14"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
