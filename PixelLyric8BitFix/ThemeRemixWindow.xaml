<Window x:Class="PixelLyric8BitFix.ThemeRemixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay — 混搭主题" Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="🔀 混搭已存主题" Foreground="#F2F5F1" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="从已存的主题里各挑一个当来源，拼一份新草稿——生成之后还是普通 JSON，回编辑页接着改都行，不会直接覆盖任何已存主题。"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <TextBlock Text="🎨 配色 + 背景 + 字体来源" Style="{StaticResource SectionHeader}"/>
            <ComboBox x:Name="CmbColorSource" DisplayMemberPath="Theme.Name" FontSize="12"/>

            <TextBlock Text="🖼️ 图标（含额外装饰层）来源" Style="{StaticResource SectionHeader}" Margin="0,18,0,0"/>
            <ComboBox x:Name="CmbIconSource" DisplayMemberPath="Theme.Name" FontSize="12"/>

            <TextBlock Text="🎬 动画来源" Style="{StaticResource SectionHeader}" Margin="0,18,0,0"/>
            <ComboBox x:Name="CmbAnimationSource" DisplayMemberPath="Theme.Name" FontSize="12"/>

            <TextBlock Text="三个都选同一个主题也没关系，混搭出来的就是它本身，纯粹是省得重打一遍。"
                       Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,18,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" HorizontalAlignment="Left" Padding="16,0" FontSize="13"/>
            <Button Grid.Column="1" x:Name="BtnGenerate" Content="🔀 生成混搭草稿" Click="BtnGenerate_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="38" Padding="16,0" FontWeight="Bold" FontSize="13"/>
        </Grid>
    </Grid>
</Window>
