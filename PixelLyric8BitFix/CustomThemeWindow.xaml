<Window x:Class="PixelLyric8BitFix.CustomThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay — 自定义主题" Height="680" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1B1B1B">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="Foreground" Value="#55FF55"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="🎨 自定义主题" Foreground="White" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="不是代码，是纯数据（颜色/渐变/像素图标/挑一种动画）——填错了会告诉你具体哪里错" Foreground="#999999" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="怎么写" Style="{StaticResource SectionHeader}"/>
                <TextBlock Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap">
                    每个主题是一份 JSON：name(名字) / font(字体) / colors(各处文字颜色) /
                    background(背景，纯色 solid 或渐变 gradient) / icon(8x8 像素图标，字符网格 + 调色板) /
                    animation(动画招式，八选一：pulse 呼吸发光、twinkle 渐隐渐现、drift 飘过、fall 飘落、bob 上下浮动、sway 摇摆、spin 旋转、flicker 不规则闪烁)。
                    颜色格式是 #RRGGBB 或带透明度的 #AARRGGBB。下面是一份完整示例，照着改就行：
                </TextBlock>

                <Border Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0" Padding="8">
                    <TextBox x:Name="TxtExample" IsReadOnly="True" TextWrapping="NoWrap"
                             Background="Transparent" BorderThickness="0" Foreground="#8AB4F8"
                             FontFamily="Consolas" FontSize="11" Height="220"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>
                <Button x:Name="BtnCopyExample" Content="📋 复制示例到剪贴板" Style="{StaticResource ActionButton}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" Click="BtnCopyExample_Click"/>

                <TextBlock x:Name="TxtThemeCount" Text="已保存的客制化主题 (0/5)" Style="{StaticResource SectionHeader}"/>
                <StackPanel x:Name="ThemeListPanel"/>
                <TextBlock x:Name="TxtNoThemes" Text="还没有存过任何客制化主题。" Foreground="#777777" FontSize="11" Margin="0,4,0,0"/>

                <TextBlock Text="粘贴 / 编辑你的 JSON" Style="{StaticResource SectionHeader}"/>
                <TextBox x:Name="TxtInput" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#111111" Foreground="#EEEEEE" BorderBrush="#333333" BorderThickness="1"
                         FontFamily="Consolas" FontSize="11" Height="180" Padding="6"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock x:Name="TxtEditingHint" Text="" Foreground="#8AB4F8" FontSize="10" Margin="0,4,0,0" Visibility="Collapsed"/>

                <Border x:Name="ErrorBox" Background="#2A1414" BorderBrush="#8A3A3A" BorderThickness="1" CornerRadius="4"
                        Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="ErrorPanel"/>
                </Border>

                <Border x:Name="SuccessBox" Background="#142A1A" BorderBrush="#3A8A4A" BorderThickness="1" CornerRadius="4"
                        Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtSuccess" Text="✅ 保存成功" Foreground="#7AE08A" FontSize="11"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnBack" Content="← 返回设置页" Click="BtnBack_Click"
                    Height="38" HorizontalAlignment="Left" Padding="16,0" FontSize="13"
                    Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Grid.Column="1" x:Name="BtnSave" Content="💾 保存这个主题" Click="BtnSave_Click"
                    Height="38" Padding="16,0" FontWeight="Bold" FontSize="13"
                    Background="#2E7D32" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
