<Window x:Class="PixelLyric8BitFix.CustomThemeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay — 自定义主题" Height="680" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">


    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="🎨 自定义主题" Foreground="#F2F5F1" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="不是代码，是纯数据（颜色/渐变/像素图标/挑一种动画）——填错了会告诉你具体哪里错" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="怎么写" Style="{StaticResource SectionHeader}"/>
                <!-- 之前这里是一整段没断句的说明文字，字段一多（八招式+组合、musicReactive、sensitivity、
                     layers……）就变成一堵密密麻麻的墙，扫一眼抓不住重点。现在只列最核心的几条，
                     完整字段说明/取值范围/组合规则这些细节挪到"下载详细说明"那份文档里——
                     那份文档结构化程度更高，人耐心看没问题，丢给 AI 读也方便（结构清楚，AI 更容易照着生成）。 -->
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap" Text="• 一份主题是一份 JSON，不是代码：改颜色/图标/动画，app 只负责照着画，不会执行任何东西。"/>
                    <TextBlock Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 六个部分：name(名字) / font(字体) / colors(配色) / background(背景) / icon(像素图标) / animation(动画，可以用 + 组合几招)。"/>
                    <TextBlock Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 可选加成：layers(最多 2 个额外小装饰)、musicReactive + sensitivity(跟着音乐变速、调反应强弱)。"/>
                    <TextBlock Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" Text="• 颜色格式 #RRGGBB 或带透明度的 #AARRGGBB。填错了保存时会告诉你具体是哪个字段。"/>
                </StackPanel>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="每个字段的取值范围、8 种动画的组合规则、完整示例——都在下面这份文档里，也可以直接丢给 AI 帮你按你想要的风格生成一份。"/>
                    <Button Grid.Column="1" x:Name="BtnDownloadSpec" Content="📄 下载详细说明" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="8,0,0,0" Click="BtnDownloadSpec_Click"/>
                </Grid>

                <Border Background="#1B211C" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="6" Margin="0,8,0,0" Padding="8">
                    <TextBox x:Name="TxtExample" IsReadOnly="True" TextWrapping="NoWrap"
                             Background="Transparent" BorderThickness="0" Foreground="#8AB4F8"
                             FontFamily="Consolas" FontSize="11" Height="220"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>
                <Button x:Name="BtnCopyExample" Content="📋 复制示例到剪贴板" Style="{StaticResource PillButtonStyle}"
                        HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0,6,0,0" Click="BtnCopyExample_Click"/>

                <TextBlock x:Name="TxtThemeCount" Text="已保存的客制化主题 (0/10)" Style="{StaticResource SectionHeader}"/>
                <StackPanel x:Name="ThemeListPanel"/>
                <TextBlock x:Name="TxtNoThemes" Text="还没有存过任何客制化主题。" Foreground="{StaticResource HintTextBrush}" FontSize="11" Margin="0,4,0,0"/>

                <TextBlock Text="粘贴 / 编辑你的 JSON" Style="{StaticResource SectionHeader}"/>
                <!-- 三个"帮你起草"的入口，独占一行（不再挤在标题右边）——窗口就 480 宽，三个按钮
                     并排放标题旁边会挤不下 -->
                <WrapPanel Margin="0,0,0,6">
                    <!-- 从别人分享的 .json 文件导入——直接把文件内容读进输入框，走的还是普通的"粘贴/校验/保存"
                         这条路，不是个人资料导入那种"读完直接覆盖本地数据"，所以不需要单独的确认弹窗：
                         读进来是不是真的存、会不会占掉上限，都还是走下面"保存"按钮已有的那套校验/上限逻辑。
                         导入会顺带清掉"正在编辑：xxx"的提示，防止读进来的是一份完全不相关的主题，
                         结果用户没留意提示还在，点保存把手头正在编辑的那份主题给覆盖了。 -->
                    <Button x:Name="BtnImportTheme" Content="📥 从文件导入" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="BtnImportTheme_Click"/>
                    <!-- 分享码是"发文件"的轻量版：一段 Base64 纯文本，聊天框里直接发一行字就行，
                         对方复制之后点这个按钮，从剪贴板里读、解出 JSON 塞进输入框——不用先存成文件
                         再发送/接收。见 CustomThemeShareCode 和 BtnImportShareCode_Click。 -->
                    <Button x:Name="BtnImportShareCode" Content="🔗 粘贴分享码导入" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="BtnImportShareCode_Click"/>
                    <!-- 不想从示例一行行改配色的话，点这个直接抽一份配好色的草稿进输入框——名字/字体/配色/背景渐变/
                         图标/动画招式都是随机挑的，但都出自"搭配好的"选项池，不会抽出互相打架的颜色。抽完照样是
                         普通 JSON 文本，想接着手改哪个字段都行，多点几下也不会覆盖已保存的主题（只改输入框）。 -->
                    <Button x:Name="BtnRandomize" Content="🎲 随机生成一份" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="BtnRandomize_Click"/>
                    <!-- 从已存的主题里"混搭"（配色/图标/动画各自挑一个来源）——至少存过 2 个主题才有意义，
                         不够的话按钮禁用，提示要先存够 2 个；跟"随机生成"是同一条路线（生成草稿塞进输入框，
                         不直接落盘），只是素材来源从内置调色板换成用户自己攒的主题 -->
                    <Button x:Name="BtnRemix" Content="🔀 混搭已存主题" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="BtnRemix_Click"/>
                    <!-- 点格子画图标，不用再自己数字符网格——打开时如果当前输入框里已经有一个合法的
                         icon（不管是手写的还是之前画过的），会先摊开续画，不是每次都从空白开始。
                         画完点"插入到编辑框"会智能替换当前 JSON 里的 icon 字段（其它字段不动），
                         输入框内容当前不是合法 JSON 的话会退化成复制到剪贴板，见 BtnPaintIcon_Click。 -->
                    <Button x:Name="BtnPaintIcon" Content="🖌️ 图标画板" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,0,6" Click="BtnPaintIcon_Click"/>
                </WrapPanel>
                <TextBox x:Name="TxtInput" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1"
                         FontFamily="Consolas" FontSize="11" Height="160" Padding="6"
                         VerticalScrollBarVisibility="Auto" TextChanged="TxtInput_TextChanged"/>
                <!-- 撤销的不是每一个字符（那个 Ctrl+Z 在 TextBox 里本来就有），是"上一次点了某个起草按钮
                     之前"的完整内容——随机生成/混搭/画板插入/导入文件/导入分享码/切到编辑某个已存主题，
                     这几个动作在改之前都会把当前内容压进一份小历史栈（见 CustomThemeWindow.xaml.cs 的
                     PushHistory），改坏了或者不如上一版就点这个一键退回，最多存 20 步。 -->
                <Button x:Name="BtnUndo" Content="↩️ 撤销上一步" Style="{StaticResource PillButtonStyle}"
                        HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0,6,0,0"
                        IsEnabled="False" Click="BtnUndo_Click"/>

                <TextBlock Text="实时预览" Style="{StaticResource SectionHeader}"/>
                <TextBlock Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6">
                    整份 JSON 跟保存时走同一套校验，全部通过才会照着更新下面这块——背景/文字配色/字体/图标动画
                    跟保存后套到播放器的实际效果一致，不用来回切皮肤对比着看。校验没过就留空，具体哪里错还是看
                    "保存"之后的报错框。
                </TextBlock>
                <!-- 整体实时预览：不是只画一张孤立的图标，而是照着主播放器的样子拼一份"缩小版"——背景/标题/
                     歌手名/歌词框/图标动画全套元素都在，字段改了这里立刻能看见，不用保存、切到主窗口对应皮肤、
                     再手动触发一次动画才发现"颜色配歪了"或者"这个招式比想的快/慢"。渲染逻辑是这个窗口自己的
                     简化版（见 CustomThemeWindow.xaml.cs 的 ApplyPreviewTheme/StartPreviewIconAnimation），
                     跟 MainWindow.Skins.cs 里真正套皮肤用的 ApplyCustomSkinVisuals/StartCustomIconAnimation
                     是两份独立实现但招式参数保持一致：这边没有音频输入，musicReactive 开关在预览里不生效
                     （动画照样播，只是不会跟着音乐变速），drift/fall 也没有三图标错位起播的效果，是刻意简化，
                     不是要跟主窗口逐像素对齐，能看出"大致是什么样"就够用。 -->
                <Border x:Name="PreviewCard" Background="#12160F" BorderBrush="#2A332B" BorderThickness="1"
                        CornerRadius="6" Height="150" ClipToBounds="True">
                    <Grid>
                        <!-- PreviewContent 整体一个 Visibility 开关：JSON 校验没过就整块收起来，不是只清掉
                             背景/图标这几个"会画出明显东西"的属性——不然文字颜色、歌词框边框这些设过的画刷
                             还留在上一次校验通过时的值上，中间那截空档会看到上一份主题的文字/边框残影，
                             不是真的"留空"。见 CustomThemeWindow.xaml.cs 的 ClearPreview。 -->
                        <Grid x:Name="PreviewContent">
                            <Canvas>
                                <Image x:Name="PreviewIcon" Width="40" Height="40" Canvas.Left="14" Canvas.Top="14"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform x:Name="PreviewIconRotate" CenterX="20" CenterY="20"/>
                                            <TranslateTransform x:Name="PreviewIconTranslate"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                    <Image.Effect>
                                        <DropShadowEffect x:Name="PreviewIconGlow" ShadowDepth="0" BlurRadius="10" Opacity="0.6"/>
                                    </Image.Effect>
                                </Image>
                            </Canvas>
                            <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12">
                                <TextBlock x:Name="PreviewTitle" Text="歌曲名示例" FontSize="16" FontWeight="Bold"/>
                                <TextBlock x:Name="PreviewArtist" Text="演出者示例" FontSize="11" Margin="0,2,0,8"/>
                                <Border x:Name="PreviewLyricBox" BorderThickness="1" CornerRadius="4" Padding="10,6" HorizontalAlignment="Left">
                                    <TextBlock x:Name="PreviewLyric" Text="这是一句示例歌词 ♪" FontSize="13"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtIconSizeHint" Text="" Foreground="{StaticResource HintTextBrush}" FontSize="9"
                                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"/>
                            <!-- theme.layers（可选，最多 2 个）的预览：贴在卡片四个角之一，动态创建，
                                 跟 MainWindow.Skins.cs 的 CustomExtraLayersHost 是同一个思路的预览版 -->
                            <Grid x:Name="PreviewLayersHost" IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="TxtPreviewHint" Text="JSON 还没校验通过，预览留空" Foreground="{StaticResource HintTextBrush}"
                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 图标细节放大：上面整体预览里图标只有 40px，网格开到 32x32/64x64 的话边缘/配色细节
                     基本看不清——单独拉一个大一点的框，原图直接放大显示，NearestNeighbor 不做任何模糊，
                     像素边缘该是方的就是方的，想确认自己画的图标对不对看这块最准。 -->
                <TextBlock Text="图标细节放大" Style="{StaticResource SectionHeader}"/>
                <Border x:Name="IconZoomCard" Background="#12160F" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="6"
                        Width="200" Height="200" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Grid>
                        <Image x:Name="IconZoomPreview" Stretch="Uniform" Margin="16"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock x:Name="TxtIconZoomHint" Text="JSON 还没校验通过，预览留空" Foreground="{StaticResource HintTextBrush}"
                                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Width="140"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="TxtIconZoomSizeHint" Text="" Foreground="{StaticResource HintTextBrush}" FontSize="10"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>

                <TextBlock x:Name="TxtEditingHint" Text="" Foreground="#8AB4F8" FontSize="10" Margin="0,4,0,0" Visibility="Collapsed"/>

                <Border x:Name="ErrorBox" Background="#2A1414" BorderBrush="#8A3A3A" BorderThickness="1" CornerRadius="4"
                        Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="ErrorPanel"/>
                </Border>

                <Border x:Name="SuccessBox" Background="#142A1A" BorderBrush="#3A8A4A" BorderThickness="1" CornerRadius="4"
                        Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtSuccess" Text="✅ 保存成功" Foreground="#7AE08A" FontSize="11"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnBack" Content="← 返回首页" Click="BtnBack_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" HorizontalAlignment="Left" Padding="16,0" FontSize="13"/>
            <Button Grid.Column="1" x:Name="BtnSave" Content="💾 保存这个主题" Click="BtnSave_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="38" Padding="16,0" FontWeight="Bold" FontSize="13"/>
        </Grid>
    </Grid>
</Window>
