<Window x:Class="PixelLyric8BitFix.IconPainterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay — 像素画板" Height="760" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="🖌️ 像素画板" Foreground="#F2F5F1" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="点格子画图标，不用再自己数字符网格。画完点&quot;插入到编辑框&quot;直接替换当前 icon 字段。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="尺寸" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="宽" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtWidth" Text="8" Width="40" FontSize="12" Margin="4,0,14,0"
                             Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1" Padding="4,2"/>
                    <TextBlock Text="高" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHeight" Text="8" Width="40" FontSize="12" Margin="4,0,14,0"
                             Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1" Padding="4,2"/>
                    <Button x:Name="BtnApplySize" Content="应用尺寸" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Click="BtnApplySize_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtSizeHint" Text="4~64 之间，改尺寸会清空当前画的内容，先想好再改。" Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="调色板" Style="{StaticResource SectionHeader}"/>
                <WrapPanel x:Name="PalettePanel"/>
                <Button x:Name="BtnAddColor" Content="🎨 添加颜色…" Style="{StaticResource PillButtonStyle}"
                        HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0,6,0,0" Click="BtnAddColor_Click"/>

                <TextBlock Text="画布" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="左键点/拖拽涂色，右键点/拖拽擦除。" Foreground="{StaticResource HintTextBrush}" FontSize="10" Margin="0,0,0,4"/>
                <!-- 大部分像素图标其实是对称或者半对称的（人脸、图形符号……），开了这个之后画一边、
                     另一边跟着自动画上（同一个颜色/擦除动作镜像一份），能省掉将近一半的点击量。
                     只做左右镜像——上下镜像对图标这种"东西"类的形状意义不大，没做 -->
                <CheckBox x:Name="ChkMirror" Content="↔️ 左右镜像绘制（画一边自动镜像另一边）" FontSize="11" Margin="0,0,0,6"/>
                <Border x:Name="CanvasBorder" Background="#12160F" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="6"
                        Padding="8" HorizontalAlignment="Left">
                    <Grid x:Name="PaintGridHost"/>
                </Border>

                <TextBlock Text="实际大小预览" Style="{StaticResource SectionHeader}"/>
                <Border Background="#12160F" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="6"
                        Width="120" Height="120" HorizontalAlignment="Left">
                    <Image x:Name="LivePreviewIcon" Stretch="Uniform" Margin="16" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" Padding="16,0" FontSize="13" Margin="0,0,8,0"/>
            <!-- 主图标可以靠"插入到编辑框"自动替换 icon 字段，但 layers[i].icon 目前还是纯手写 JSON，
                 没有对应的"自动插入"目标——留这个按钮单独复制一份 { palette, rows } 片段，
                 想画层装饰图标的话画完复制、手动粘到 layers 里对应的位置就行 -->
            <Button Grid.Column="1" x:Name="BtnCopyFragment" Content="📋 只复制 JSON 片段（给 layers 用）" Click="BtnCopyFragment_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" HorizontalAlignment="Left" Padding="10,0" FontSize="11"/>
            <Button Grid.Column="2" x:Name="BtnClear" Content="🗑 清空" Click="BtnClear_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" Padding="12,0" FontSize="12" Margin="0,0,8,0"/>
            <Button Grid.Column="3" x:Name="BtnInsert" Content="✅ 插入到编辑框" Click="BtnInsert_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="38" Padding="16,0" FontWeight="Bold" FontSize="13"/>
        </Grid>
    </Grid>
</Window>
