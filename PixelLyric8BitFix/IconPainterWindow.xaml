<Window x:Class="PixelLyric8BitFix.IconPainterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="ZipPlay — 像素画板" Height="680" Width="480"
        MinHeight="480" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="🖌️ 像素画板" Foreground="#F2F5F1" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="点格子画图标，不用再自己数字符网格。画完点&quot;插入到编辑框&quot;直接替换当前 icon 字段。" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <TextBlock Text="尺寸" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="宽" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtWidth" Text="8" Width="40" FontSize="12" Margin="4,0,14,0"
                             Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1" Padding="4,2"/>
                    <TextBlock Text="高" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtHeight" Text="8" Width="40" FontSize="12" Margin="4,0,14,0"
                             Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1" Padding="4,2"/>
                    <Button x:Name="BtnApplySize" Content="应用尺寸" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Click="BtnApplySize_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtSizeHint" Text="4~64 之间，改尺寸会清空当前画的内容，先想好再改。" Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="调色板" Style="{StaticResource SectionHeader}"/>
                <WrapPanel x:Name="PalettePanel"/>
                <Button x:Name="BtnAddColor" Content="🎨 添加颜色…" Style="{StaticResource PillButtonStyle}"
                        HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0,6,0,0" Click="BtnAddColor_Click"/>
                <TextBlock Text="左键选中颜色，右键删除；画布上还在用这个颜色的话删不掉，先换掉/擦掉再删。" Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="画布" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="左键点/拖拽涂色，右键点/拖拽擦除；Ctrl+Z 撤销，Ctrl+Y 重做。" Foreground="{StaticResource HintTextBrush}" FontSize="10" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="RbToolPaint" Content="🖌️ 画笔" GroupName="PainterTool" IsChecked="True"
                                 Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,14,0"/>
                    <RadioButton x:Name="RbToolFill" Content="🪣 填充（点一下填满连通区域）" GroupName="PainterTool"
                                 Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="BtnUndo" Content="↩️ 撤销" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnUndo_Click"/>
                    <Button x:Name="BtnRedo" Content="↪️ 重做" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Click="BtnRedo_Click"/>
                </StackPanel>
                <!-- 大部分像素图标其实是对称或者半对称的（人脸、图形符号……），开了这个之后画一边、
                     另一边跟着自动画上（同一个颜色/擦除动作镜像一份），能省掉将近一半的点击量。
                     只做左右镜像——上下镜像对图标这种"东西"类的形状意义不大，没做 -->
                <CheckBox x:Name="ChkMirror" Content="↔️ 左右镜像绘制（画一边自动镜像另一边）" FontSize="11" Margin="0,0,0,4"/>
                <CheckBox x:Name="ChkOnionSkin" Content="🧅 洋葱皮（半透明显示上一帧，多帧动画对齐用）" FontSize="11" Margin="0,0,0,6"
                          Checked="ChkOnionSkin_Changed" Unchecked="ChkOnionSkin_Changed"/>
                <TextBlock x:Name="TxtCellCoord" Text="" Foreground="{StaticResource HintTextBrush}" FontSize="10" Margin="0,0,0,4"/>
                <Border x:Name="CanvasBorder" Background="#12160F" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="6"
                        Padding="8" HorizontalAlignment="Left">
                    <Grid x:Name="PaintGridHost"/>
                </Border>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="BtnImportImage" Content="🖼️ 导入图片…" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnImportImage_Click"/>
                    <Button x:Name="BtnExportPng" Content="📤 导出当前帧为 PNG…" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Click="BtnExportPng_Click"/>
                </WrapPanel>

                <!-- 动作（icon.actions，可选）：点一下装饰图标能循环切换的额外姿势/画法，每个动作
                     自己独立一套"帧"（下面那个"帧"区块编辑的永远是"当前选中这个动作"的帧）。
                     动作 0 固定是 icon 自己的 rows/frames（Mini 小方块/分享卡片永远只认这一份），
                     不可改名/删除；额外动作可以任意加/命名/删，所有动作共用同一个画布尺寸。 -->
                <TextBlock Text="动作（可选，点击装饰图标可循环切换）" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="下面&quot;帧&quot;区块编辑的是当前选中这个动作的画面。动作 0 是默认外观（Mini 小方块/分享卡片只认它），额外动作会写进 icon.actions，点一下装饰图标能循环切到下一个，绕完一圈回到动作 0，或者填了下面的自动切换阈值就不用点。每个动作还能有自己的移动方式（animation，覆盖上面主题的 sway/drift 等），这个画板暂时还没有对应的选择器，想用的话在“插入到编辑框”之后手动往这个动作的 JSON 里加一个 animation 字段（形状跟顶层 animation 一样，drift/fall 不能用），详见“下载详细说明”。"
                           Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel x:Name="ActionStripPanel" Margin="0,0,0,6"/>
                <Button x:Name="BtnAddAction" Content="➕ 新增动作" Style="{StaticResource PillButtonStyle}"
                        HorizontalAlignment="Left" Padding="10,4" FontSize="11" Margin="0,0,0,6" Click="BtnAddAction_Click"/>
                <StackPanel x:Name="ActionMetaPanel" Visibility="Collapsed" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="名称" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtActionName" Width="120" FontSize="12" Margin="4,0,14,0"
                                 Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1" Padding="4,2"
                                 LostFocus="TxtActionName_LostFocus"/>
                        <TextBlock Text="帧间隔(秒，留空继承上面)" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtActionFrameDuration" Width="50" FontSize="12" Margin="4,0,0,0"
                                 Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1" Padding="4,2"
                                 LostFocus="TxtActionFrameDuration_LostFocus"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="自动切换阈值(秒，留空=纯手动点击)" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtActionAutoSwitchSeconds" Width="50" FontSize="12" Margin="4,0,0,0"
                                 Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1" Padding="4,2"
                                 LostFocus="TxtActionAutoSwitchSeconds_LostFocus"/>
                    </StackPanel>
                    <TextBlock Text="填了的话，当前歌曲不用点击、连续播放满这么多秒就自动切到这个动作（暂停不计时，换歌重新计）。" Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <Button x:Name="BtnDeleteAction" Content="🗑 删除此动作" Style="{StaticResource PillButtonStyle}"
                            HorizontalAlignment="Left" Padding="10,4" FontSize="11" Click="BtnDeleteAction_Click"/>
                </StackPanel>

                <!-- 帧（逐帧动画，可选）：只有 1 帧的话就是普通静态图标，插入到编辑框走的还是老的 icon.rows；
                     2 帧以上才会产出 icon.frames，主图标会真的逐帧循环播放，见 CustomTheme.cs 里
                     icon.frames 的说明。跟 Steve 走路是同一个思路——不是变换（旋转/缩放）动，
                     是画好几张图交替显示。这里编辑的永远是上面"动作"区块当前选中的那一个。 -->
                <TextBlock Text="帧（逐帧动画，可选）" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="只有 1 帧就是普通静态图标；2 帧以上会在编辑框里生成 icon.frames，主图标会真的逐帧循环播放（跟 Minecraft 皮肤走路换腿同一个原理）。切帧不会丢掉别的帧画的内容，调色板是所有帧共用的同一份。缩略图可以直接拖拽调整播放顺序。"
                           Foreground="{StaticResource HintTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <WrapPanel x:Name="FrameStripPanel" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,6">
                    <Button x:Name="BtnAddFrame" Content="➕ 新增帧" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnAddFrame_Click"/>
                    <Button x:Name="BtnDuplicateFrame" Content="📋 复制当前帧" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BtnDuplicateFrame_Click"/>
                    <Button x:Name="BtnDeleteFrame" Content="🗑 删除当前帧" Style="{StaticResource PillButtonStyle}"
                            Padding="10,4" FontSize="11" Click="BtnDeleteFrame_Click"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="帧间隔(秒)" Foreground="{StaticResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <!-- TextChanged 故意不在这里用 XAML 声明式挂——XAML 里写的 Text="0.25" 这个初始值
                         在 InitializeComponent() 期间赋值时就会同步触发一次 TextChanged，而这个 TextBox
                         在文档里排在 LivePreviewIcon/TxtPreviewFrameHint 前面，那时候这两个后声明的
                         控件还没被 Connect()，处理器里一摸就是 NullReferenceException。改成在
                         IconPainterWindow.xaml.cs 构造函数末尾、其它字段都就绪之后才用代码订阅。 -->
                    <TextBox x:Name="TxtFrameDuration" Text="0.25" Width="50" FontSize="12" Margin="4,0,0,0"
                             Background="#1B211C" Foreground="#EEEEEE" BorderBrush="#2A332B" BorderThickness="1" Padding="4,2"/>
                </StackPanel>

                <TextBlock Text="实际大小预览" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="TxtPreviewFrameHint" Text="" Foreground="{StaticResource HintTextBrush}" FontSize="10" Margin="0,0,0,4"/>
                <Border Background="#12160F" BorderBrush="#2A332B" BorderThickness="1" CornerRadius="6"
                        Width="120" Height="120" HorizontalAlignment="Left">
                    <Image x:Name="LivePreviewIcon" Stretch="Uniform" Margin="16" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" Padding="16,0" FontSize="13" Margin="0,0,8,0"/>
            <!-- 主图标可以靠"插入到编辑框"自动替换 icon 字段，但 layers[i].icon 目前还是纯手写 JSON，
                 没有对应的"自动插入"目标——留这个按钮单独复制一份 { palette, rows } 片段，
                 想画层装饰图标的话画完复制、手动粘到 layers 里对应的位置就行 -->
            <Button Grid.Column="1" x:Name="BtnCopyFragment" Content="📋 只复制 JSON 片段（给 layers 用）" Click="BtnCopyFragment_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" HorizontalAlignment="Left" Padding="10,0" FontSize="11"/>
            <Button Grid.Column="2" x:Name="BtnClear" Content="🗑 清空" Click="BtnClear_Click"
                    Style="{StaticResource PillButtonStyle}"
                    Height="38" Padding="12,0" FontSize="12" Margin="0,0,8,0"/>
            <Button Grid.Column="3" x:Name="BtnInsert" Content="✅ 插入到编辑框" Click="BtnInsert_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="38" Padding="16,0" FontWeight="Bold" FontSize="13"/>
        </Grid>
    </Grid>
</Window>
