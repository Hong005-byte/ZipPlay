<Application x:Class="PixelLyric8BitFix.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelLyric8BitFix"
             StartupUri="SplashWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- 翡翠绿高级感配色：app 级别的共享调色板 + 按钮样式，WelcomeWindow/HomeWindow 都从这里取，
             以后别的窗口想跟上这套风格也是直接引用这几个 key，不用每个窗口自己抄一份。
             放在 App.xaml 里还有个好处：Window 自己的 Background 特性能直接引用这些资源——
             如果资源定义在 Window 自己的 Resources 里，Window 解析自己的 Background 特性时资源字典
             还没填好，会直接崩在启动阶段（WelcomeWindow 最早就是这么踩的坑）。 -->
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#171C17" Offset="0"/>
            <GradientStop Color="#0F120F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBarBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#D8B26B" Offset="0"/>
            <GradientStop Color="#34D399" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentBrush" Color="#34D399"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#93A296"/>
        <SolidColorBrush x:Key="HintTextBrush" Color="#5C6B5E"/>

        <!-- 各个设置子页面（本地数据/关于/皮肤主题/听歌统计/播放器外观/自定义主题/音频律动）里
             一节一节的小标题，之前这几个 Setter 在 7 个窗口的 Window.Resources 里各抄了一份，
             改一次要改 7 个文件，放这儿一份大家共用 -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <!-- 主按钮（开始使用/保存/确定导入/开始播放）：实心翡翠绿，hover/pressed 分两级亮度，禁用态退成灰绿 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1F9D63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26B876"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17824F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#2A332B"/>
                                <Setter Property="Foreground" Value="#5C6B5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮（更换头像/移除/导出/导入/取消）：深色描边卡片，hover 的时候边框跟主色调一起亮起来 -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1B211C"/>
            <Setter Property="Foreground" Value="#D7E0D8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#2A332B" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#34D399"/>
                                <Setter TargetName="Bd" Property="Background" Value="#212820"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "移除头像"这类暖色警示文字，视觉权重跟 PillButtonStyle 一致，只是字色偏警示 -->
        <Style x:Key="DangerPillButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
            <Setter Property="Foreground" Value="#E08A72"/>
        </Style>

        <!-- 头像圆圈描边：平时是低调的深绿灰，鼠标移上去亮成翡翠绿，暗示"这里能点" -->
        <Style x:Key="AvatarRingStyle" TargetType="Ellipse">
            <Setter Property="Stroke" Value="#2A332B"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Stroke" Value="#34D399"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- CheckBox/RadioButton/ScrollBar 不用每个窗口自己套一份——这三个不带 x:Key，是隐式全局样式，
             整个 app 里所有没单独指定 Style 的 CheckBox/RadioButton/ScrollBar 自动套上这套深色+翡翠绿
             的皮肤。个别窗口如果需要完全不同的形状（比如皮肤选择页那种预览卡片式单选框），照样可以用
             x:Key 自己定义一份，具体样式会盖过这里的隐式样式，互不冲突。 -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D7E0D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                                    BorderBrush="#2A332B" Background="#1B211C" VerticalAlignment="Center">
                                <TextBlock x:Name="Check" Text="✓" FontSize="11" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#1F9D63"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#1F9D63"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D7E0D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Circle" Width="16" Height="16" CornerRadius="8" BorderThickness="1.5"
                                    BorderBrush="#2A332B" Background="#1B211C" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="White" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#1F9D63"/>
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#1F9D63"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 细窄深色滚动条：只画一根圆角小竖条当拖拽把手，两头的翻页按钮直接透明化（点击区域还在，
             用得着的话方向键/PageUp/PageDown 照样管用，只是不再画那两个方向箭头占地方） -->
        <Style x:Key="AppScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#2A332B" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource AppScrollBarThumb}" Width="6"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
