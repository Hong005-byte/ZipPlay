<Window x:Class="PixelLyric8BitFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelLyric8BitFix"
        mc:Ignorable="d"
        Title="ZipPlay" Height="260" Width="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- MC 皮肤：只负责整体的轻微上下呼吸感；Steve 的行走范围要按窗口宽度算，改在代码里驱动 -->
        <Storyboard x:Key="MinecraftWorldAnimation">
            <DoubleAnimation Storyboard.TargetName="MainBlockTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-5" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="VinylSpinAnimation">
            <DoubleAnimation Storyboard.TargetName="VinylRotate" Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:4" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 简约风：进度条外发光缓慢明暗呼吸，安静不抢戏 -->
        <Storyboard x:Key="SimplePulseAnimation">
            <DoubleAnimation Storyboard.TargetName="SimpleSkinBg" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                             From="0.35" To="0.7" Duration="0:0:2.2" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- CRT 终端风：扫描线缓慢向下滚动 + 屏幕轻微闪烁，老显示器的感觉 -->
        <Storyboard x:Key="CrtFlickerAnimation">
            <DoubleAnimation Storyboard.TargetName="ScanlineTransform" Storyboard.TargetProperty="Y"
                             From="0" To="3" Duration="0:0:0.35" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="CrtSkinBg" Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                             From="0.22" To="0.45" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 赛博朋克风：大部分时间稳定发光，每隔几秒才"闪"一下（像真的快坏掉的霓虹灯管），不是一直明暗 -->
        <Storyboard x:Key="CyberpunkGlowAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CyberpunkSkinBg"
                                            Storyboard.TargetProperty="(Border.Effect).(DropShadowEffect.Opacity)"
                                            RepeatBehavior="Forever">
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:1.6"/>
                <LinearDoubleKeyFrame Value="0.15" KeyTime="0:0:1.65"/>
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:1.72"/>
                <LinearDoubleKeyFrame Value="0.2" KeyTime="0:0:1.78"/>
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:1.86"/>
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:4.2"/>
                <LinearDoubleKeyFrame Value="0.1" KeyTime="0:0:4.25"/>
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:4.34"/>
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:6"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- 玻璃拟态风：平时看起来完好，每隔几秒"裂开"一下再愈合，比一直呼吸发光明显多了 -->
        <Storyboard x:Key="GlassCrackAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GlassCrackOverlay"
                                            Storyboard.TargetProperty="Opacity"
                                            RepeatBehavior="Forever">
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:3.5"/>
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:3.65"/>
                <LinearDoubleKeyFrame Value="1" KeyTime="0:0:4.6"/>
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:6.2"/>
                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:8"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- Lofi 咖啡馆风：杯口两道热气线交替袅袅上升、变淡 -->
        <Storyboard x:Key="LofiSteamAnimation">
            <DoubleAnimation Storyboard.TargetName="SteamTransform1" Storyboard.TargetProperty="Y"
                             From="0" To="-14" Duration="0:0:2.2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Steam1" Storyboard.TargetProperty="Opacity"
                             From="0.75" To="0" Duration="0:0:2.2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="SteamTransform2" Storyboard.TargetProperty="Y"
                             From="0" To="-14" Duration="0:0:2.2" BeginTime="0:0:1.1" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Steam2" Storyboard.TargetProperty="Opacity"
                             From="0.6" To="0" Duration="0:0:2.2" BeginTime="0:0:1.1" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 极光/雪夜风：背景色带缓慢流动 + 几片雪花各自不同步地飘落，营造静谧夜雪感 -->
        <Storyboard x:Key="AuroraSkyAnimation">
            <ColorAnimation Storyboard.TargetName="AuroraStop2" Storyboard.TargetProperty="Color"
                            From="#123B33" To="#2A1F4D" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Snow1" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Snow2" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:6.5" BeginTime="0:0:1" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Snow3" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:4.2" BeginTime="0:0:2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Snow4" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:7" BeginTime="0:0:0.5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Snow5" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:5.5" BeginTime="0:0:3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Snow6" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:6" BeginTime="0:0:1.5" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 雨夜窗景风：雨滴以不同速度、错开时间往下掉，比雪花快很多 -->
        <Storyboard x:Key="RainAnimation">
            <DoubleAnimation Storyboard.TargetName="Drop1" Storyboard.TargetProperty="(Canvas.Top)" From="-14" To="160" Duration="0:0:0.9" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Drop2" Storyboard.TargetProperty="(Canvas.Top)" From="-14" To="160" Duration="0:0:1.1" BeginTime="0:0:0.2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Drop3" Storyboard.TargetProperty="(Canvas.Top)" From="-14" To="160" Duration="0:0:0.8" BeginTime="0:0:0.4" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Drop4" Storyboard.TargetProperty="(Canvas.Top)" From="-14" To="160" Duration="0:0:1.0" BeginTime="0:0:0.1" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Drop5" Storyboard.TargetProperty="(Canvas.Top)" From="-14" To="160" Duration="0:0:0.85" BeginTime="0:0:0.5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Drop6" Storyboard.TargetProperty="(Canvas.Top)" From="-14" To="160" Duration="0:0:1.05" BeginTime="0:0:0.3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Drop7" Storyboard.TargetProperty="(Canvas.Top)" From="-14" To="160" Duration="0:0:0.95" BeginTime="0:0:0.6" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Drop8" Storyboard.TargetProperty="(Canvas.Top)" From="-14" To="160" Duration="0:0:0.75" BeginTime="0:0:0.15" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 星空太空风：每颗星星各自不同步地忽明忽暗，营造安静的夜空闪烁感 -->
        <Storyboard x:Key="StarryTwinkleAnimation">
            <DoubleAnimation Storyboard.TargetName="Star1" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Star2" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1.8" BeginTime="0:0:0.3" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Star3" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:2.1" BeginTime="0:0:0.6" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Star4" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:1.6" BeginTime="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Star5" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:1.9" BeginTime="0:0:0.2" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Star6" Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1.5" BeginTime="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Star7" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:2.3" BeginTime="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Star8" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:1.7" BeginTime="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 篝火露营风：火苗持续轻微闪烁 + 两粒火星交替飘起、变淡 -->
        <Storyboard x:Key="CampfireAnimation">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CampfireGlow" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
                <LinearDoubleKeyFrame Value="0.5" KeyTime="0:0:0"/>
                <LinearDoubleKeyFrame Value="0.75" KeyTime="0:0:0.15"/>
                <LinearDoubleKeyFrame Value="0.45" KeyTime="0:0:0.3"/>
                <LinearDoubleKeyFrame Value="0.7" KeyTime="0:0:0.42"/>
                <LinearDoubleKeyFrame Value="0.55" KeyTime="0:0:0.6"/>
                <LinearDoubleKeyFrame Value="0.8" KeyTime="0:0:0.75"/>
                <LinearDoubleKeyFrame Value="0.5" KeyTime="0:0:0.9"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="EmberTransform1" Storyboard.TargetProperty="Y" From="0" To="-20" Duration="0:0:1.8" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Ember1" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.8" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="EmberTransform2" Storyboard.TargetProperty="Y" From="0" To="-20" Duration="0:0:1.8" BeginTime="0:0:0.9" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Ember2" Storyboard.TargetProperty="Opacity" From="0.8" To="0" Duration="0:0:1.8" BeginTime="0:0:0.9" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 樱花风：花瓣一边往下飘一边左右轻轻摇摆，比直线下落更自然 -->
        <Storyboard x:Key="SakuraAnimation">
            <DoubleAnimation Storyboard.TargetName="Petal1" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:6" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal1" Storyboard.TargetProperty="(Canvas.Left)" From="20" To="35" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal2" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:7.5" BeginTime="0:0:1" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal2" Storyboard.TargetProperty="(Canvas.Left)" From="80" To="65" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal3" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:5.2" BeginTime="0:0:2" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal3" Storyboard.TargetProperty="(Canvas.Left)" From="140" To="155" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal4" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:8" BeginTime="0:0:0.5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal4" Storyboard.TargetProperty="(Canvas.Left)" From="190" To="175" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal5" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:6.8" BeginTime="0:0:3" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal5" Storyboard.TargetProperty="(Canvas.Left)" From="240" To="255" Duration="0:0:1.7" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal6" Storyboard.TargetProperty="(Canvas.Top)" From="-10" To="160" Duration="0:0:7" BeginTime="0:0:1.5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="Petal6" Storyboard.TargetProperty="(Canvas.Left)" From="270" To="255" Duration="0:0:1.9" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>

        <!-- 复古磁带机风：两个卷盘一起转，左边（供带盘）转得比右边（收带盘）慢一点，更像真的磁带在走带 -->
        <Storyboard x:Key="CassetteSpinAnimation">
            <DoubleAnimation Storyboard.TargetName="ReelLeftRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:5" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="ReelRightRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:3.4" RepeatBehavior="Forever"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RenderTransform>
            <TranslateTransform x:Name="MainBlockTransform" Y="0"/>
        </Grid.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RowDecor" Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Minecraft 皮肤专属装饰（小树 + 走动的 Steve） -->
            <Canvas x:Name="MinecraftDecorCanvas" Grid.Row="0" Margin="10,0,10,-2" Panel.ZIndex="10">
                <Image x:Name="ImgTree" Width="40" Height="50" Canvas.Right="40" Canvas.Bottom="0" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <Ellipse Width="16" Height="3" Fill="#55000000" Canvas.Bottom="0" Canvas.Left="2">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="ShadowTransform" X="20"/>
                    </Ellipse.RenderTransform>
                </Ellipse>

                <Image x:Name="ImgSteve" Width="20" Height="40" Canvas.Bottom="2" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <!-- 走路朝向：往右走 ScaleX=1，往左走翻转成 -1，代码里按位移方向实时切换 -->
                            <ScaleTransform x:Name="SteveFlip" ScaleX="1"/>
                            <TranslateTransform x:Name="SteveTransform" X="20"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Canvas>

            <!-- 黑胶皮肤专属装饰：做成迷你唱机——底座 + 转动的唱片 + 静止的唱臂。
                 纯同心圆怎么转都长一样（旋转对称），根本看不出在动，
                 所以唱片上加了两道不对称的反光划痕，唱臂固定不动作参照物，转动才真的看得出来。 -->
            <Canvas x:Name="VinylDecorCanvas" Grid.Row="0" Margin="10,0,10,-2" Panel.ZIndex="10" Visibility="Collapsed">
                <!-- 唱机底座 -->
                <Border Width="46" Height="7" CornerRadius="3" Background="#241811" Canvas.Right="6" Canvas.Bottom="0"/>

                <!-- 唱片本体：旋转 -->
                <Canvas Width="42" Height="42" Canvas.Right="8" Canvas.Bottom="5" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="VinylRotate" Angle="0"/>
                    </Canvas.RenderTransform>
                    <Ellipse Width="42" Height="42">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#1A1A1A" Offset="0"/>
                                <GradientStop Color="#0A0A0A" Offset="0.5"/>
                                <GradientStop Color="#1A1A1A" Offset="0.55"/>
                                <GradientStop Color="#0A0A0A" Offset="0.75"/>
                                <GradientStop Color="#1A1A1A" Offset="0.8"/>
                                <GradientStop Color="#0A0A0A" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Line X1="21" Y1="2" X2="21" Y2="16" Stroke="#77FFFFFF" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="30" Y1="9" X2="35" Y2="17" Stroke="#44FFFFFF" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Ellipse Width="14" Height="14" Canvas.Left="14" Canvas.Top="14" Fill="#C9A227"/>
                    <Ellipse Width="3" Height="3" Canvas.Left="19.5" Canvas.Top="19.5" Fill="#1A1A1A"/>
                </Canvas>

                <!-- 唱臂：固定不动，跟转动的唱片形成对比 -->
                <Line X1="0" Y1="0" X2="16" Y2="11" Stroke="#AAAAAA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Right="4" Canvas.Top="0"/>
                <Ellipse Width="5" Height="5" Fill="#888888" Canvas.Right="1" Canvas.Top="-2"/>
            </Canvas>

            <!-- Lofi 咖啡馆皮肤专属装饰：咖啡杯 + 两道袅袅升起、交替变淡的热气线 -->
            <Canvas x:Name="LofiDecorCanvas" Grid.Row="0" Margin="10,0,10,-2" Panel.ZIndex="10" Visibility="Collapsed">
                <Image x:Name="ImgCoffeeCup" Width="22" Height="19" Canvas.Right="14" Canvas.Bottom="2" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <Path x:Name="Steam1" Stroke="#E8D9C0" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M0,20 Q4,14 0,8 Q-4,3 0,-2" Canvas.Right="21" Canvas.Bottom="19">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="SteamTransform1" Y="0"/>
                    </Path.RenderTransform>
                </Path>
                <Path x:Name="Steam2" Stroke="#E8D9C0" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M0,20 Q4,14 0,8 Q-4,3 0,-2" Canvas.Right="14" Canvas.Bottom="19">
                    <Path.RenderTransform>
                        <TranslateTransform x:Name="SteamTransform2" Y="0"/>
                    </Path.RenderTransform>
                </Path>
            </Canvas>

            <!-- 篝火露营皮肤专属装饰：篝火图标（自带闪烁发光）+ 两粒交替飘起的火星 -->
            <Canvas x:Name="CampfireDecorCanvas" Grid.Row="0" Margin="10,0,10,-2" Panel.ZIndex="10" Visibility="Collapsed">
                <Image x:Name="ImgCampfire" Width="22" Height="22" Canvas.Right="14" Canvas.Bottom="2" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Image.Effect>
                        <DropShadowEffect x:Name="CampfireGlow" Color="#FF8C00" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                    </Image.Effect>
                </Image>
                <Ellipse x:Name="Ember1" Width="2" Height="2" Fill="#FFAA3A" Canvas.Right="18" Canvas.Bottom="22">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="EmberTransform1" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="Ember2" Width="1.5" Height="1.5" Fill="#FFD27A" Canvas.Right="12" Canvas.Bottom="22">
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="EmberTransform2" Y="0"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- 复古磁带机皮肤专属装饰：磁带壳里两个转动的卷盘，十字辐条打破旋转对称性，转动才看得出来 -->
            <Canvas x:Name="CassetteDecorCanvas" Grid.Row="0" Margin="10,0,10,-2" Panel.ZIndex="10" Visibility="Collapsed">
                <Border Width="70" Height="34" CornerRadius="4" Background="#3A2E22" BorderBrush="#8A6A4A" BorderThickness="1"
                        Canvas.Right="0" Canvas.Bottom="4"/>

                <Canvas Width="16" Height="16" Canvas.Right="46" Canvas.Bottom="10" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="ReelLeftRotate" Angle="0"/>
                    </Canvas.RenderTransform>
                    <Ellipse Width="16" Height="16" Fill="#D9C9A8"/>
                    <Line X1="8" Y1="1" X2="8" Y2="15" Stroke="#5A4632" StrokeThickness="1"/>
                    <Line X1="1" Y1="8" X2="15" Y2="8" Stroke="#5A4632" StrokeThickness="1"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="6" Fill="#3A2E22"/>
                </Canvas>

                <Canvas Width="16" Height="16" Canvas.Right="10" Canvas.Bottom="10" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="ReelRightRotate" Angle="0"/>
                    </Canvas.RenderTransform>
                    <Ellipse Width="16" Height="16" Fill="#D9C9A8"/>
                    <Line X1="8" Y1="1" X2="8" Y2="15" Stroke="#5A4632" StrokeThickness="1"/>
                    <Line X1="1" Y1="8" X2="15" Y2="8" Stroke="#5A4632" StrokeThickness="1"/>
                    <Ellipse Width="4" Height="4" Canvas.Left="6" Canvas.Top="6" Fill="#3A2E22"/>
                </Canvas>
            </Canvas>

            <Grid Grid.Row="1">
                <!-- 皮肤 1：Minecraft 像素风背景（泥土纹理） -->
                <Border x:Name="MinecraftSkinBg" BorderBrush="#4D9244" BorderThickness="0,4,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor">
                    <Border.Background>
                        <ImageBrush x:Name="DirtBrush" TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#281A12" BlurRadius="12" ShadowDepth="4" Opacity="0.85"/>
                    </Border.Effect>
                </Border>

                <!-- 皮肤 2：简约风背景（纯色面板，不生成任何贴图，更轻量） -->
                <Border x:Name="SimpleSkinBg" Background="#1C1C1C" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.6"/>
                    </Border.Effect>
                </Border>

                <!-- 皮肤 3：复古 CRT 终端风（纯黑底 + 绿色边框，扫描线在最上层单独叠加） -->
                <Border x:Name="CrtSkinBg" Background="#050505" BorderBrush="#1F5C2E" BorderThickness="2" CornerRadius="2" Visibility="Collapsed">
                    <Border.Effect>
                        <DropShadowEffect Color="#33FF66" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
                    </Border.Effect>
                </Border>

                <!-- 皮肤 4：霓虹赛博朋克风（深紫渐变 + 粉青霓虹边框） -->
                <Border x:Name="CyberpunkSkinBg" BorderThickness="2" CornerRadius="6" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A0B2E" Offset="0"/>
                            <GradientStop Color="#0F0C29" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF2ED1" Offset="0"/>
                            <GradientStop Color="#00F0FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#00F0FF" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                </Border>

                <!-- 皮肤 5：黑胶唱片机风（暖棕渐变 + 黄铜边框） -->
                <Border x:Name="VinylSkinBg" BorderBrush="#C9A227" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3A2A1E" Offset="0"/>
                            <GradientStop Color="#241811" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.7"/>
                    </Border.Effect>
                </Border>

                <!-- 皮肤 6：玻璃拟态风（半透明磨砂面板；WPF 没有真正的背景模糊，用半透明渐变模拟） -->
                <Border x:Name="GlassSkinBg" BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33FFFFFF" Offset="0"/>
                            <GradientStop Color="#14FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#4DFFFFFF"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
                    </Border.Effect>
                </Border>

                <!-- 玻璃拟态专属：平时看不见，周期性"裂开"再"愈合"。用 Viewbox 把设计尺寸拉伸铺满整个面板，
                     跟窗口实际大小（小/中/大预设）无关都能对得上。 -->
                <Viewbox x:Name="GlassCrackOverlay" Stretch="Fill" Opacity="0" IsHitTestVisible="False">
                    <Canvas Width="300" Height="150">
                        <Ellipse Width="6" Height="6" Canvas.Left="157" Canvas.Top="57" Fill="#CCFFFFFF"/>
                        <Path Stroke="#CCFFFFFF" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M160,60 L120,20 M160,60 L90,70 M160,60 L110,120 M160,60 L190,130 M160,60 L230,90 M160,60 L210,25"/>
                        <Path Stroke="#77FFFFFF" StrokeThickness="0.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M120,20 L100,5 M90,70 L55,60 M110,120 L95,145 M230,90 L260,100 M210,25 L235,10"/>
                    </Canvas>
                </Viewbox>

                <!-- 皮肤 7：复古咖啡馆 / lofi 风（暖棕渐变，安静温馨） -->
                <Border x:Name="LofiSkinBg" BorderBrush="#8A6A4A" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2E2118" Offset="0"/>
                            <GradientStop Color="#1C140D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.6"/>
                    </Border.Effect>
                </Border>

                <!-- 皮肤 8：极光 / 雪夜风（深蓝绿夜空渐变，色带会缓慢流动） -->
                <Border x:Name="AuroraSkinBg" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0B1E2D" Offset="0"/>
                            <GradientStop x:Name="AuroraStop2" Color="#123B33" Offset="0.5"/>
                            <GradientStop Color="#0B1E2D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#4FD8C4"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#4FD8C4" BlurRadius="14" ShadowDepth="0" Opacity="0.4"/>
                    </Border.Effect>
                </Border>

                <!-- 极光皮肤专属：飘落的雪花，用 Viewbox 拉伸铺满整个面板 -->
                <Viewbox x:Name="AuroraSnowOverlay" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed">
                    <Canvas Width="300" Height="150" ClipToBounds="True">
                        <Ellipse x:Name="Snow1" Width="4" Height="4" Fill="#CCFFFFFF" Canvas.Left="30" Canvas.Top="-10"/>
                        <Ellipse x:Name="Snow2" Width="3" Height="3" Fill="#AAFFFFFF" Canvas.Left="90" Canvas.Top="-10"/>
                        <Ellipse x:Name="Snow3" Width="5" Height="5" Fill="#DDFFFFFF" Canvas.Left="150" Canvas.Top="-10"/>
                        <Ellipse x:Name="Snow4" Width="3" Height="3" Fill="#99FFFFFF" Canvas.Left="200" Canvas.Top="-10"/>
                        <Ellipse x:Name="Snow5" Width="4" Height="4" Fill="#BBFFFFFF" Canvas.Left="250" Canvas.Top="-10"/>
                        <Ellipse x:Name="Snow6" Width="3" Height="3" Fill="#88FFFFFF" Canvas.Left="270" Canvas.Top="-10"/>
                    </Canvas>
                </Viewbox>

                <!-- 皮肤 9：雨夜窗景风（深蓝灰渐变，像隔着窗户看夜雨） -->
                <Border x:Name="RainSkinBg" BorderThickness="1" CornerRadius="4" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A2530" Offset="0"/>
                            <GradientStop Color="#0D1318" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#4A6572"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#4A6572" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                    </Border.Effect>
                </Border>

                <!-- 雨夜专属：雨滴沿窗滑落 -->
                <Viewbox x:Name="RainOverlay" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed">
                    <Canvas Width="300" Height="150" ClipToBounds="True">
                        <Line x:Name="Drop1" X1="0" Y1="0" X2="-4" Y2="14" Stroke="#99A8C5D6" StrokeThickness="1.2" Canvas.Left="20" Canvas.Top="-14"/>
                        <Line x:Name="Drop2" X1="0" Y1="0" X2="-4" Y2="14" Stroke="#77A8C5D6" StrokeThickness="1" Canvas.Left="70" Canvas.Top="-14"/>
                        <Line x:Name="Drop3" X1="0" Y1="0" X2="-4" Y2="14" Stroke="#99A8C5D6" StrokeThickness="1.2" Canvas.Left="120" Canvas.Top="-14"/>
                        <Line x:Name="Drop4" X1="0" Y1="0" X2="-4" Y2="14" Stroke="#66A8C5D6" StrokeThickness="1" Canvas.Left="170" Canvas.Top="-14"/>
                        <Line x:Name="Drop5" X1="0" Y1="0" X2="-4" Y2="14" Stroke="#99A8C5D6" StrokeThickness="1.2" Canvas.Left="220" Canvas.Top="-14"/>
                        <Line x:Name="Drop6" X1="0" Y1="0" X2="-4" Y2="14" Stroke="#77A8C5D6" StrokeThickness="1" Canvas.Left="260" Canvas.Top="-14"/>
                        <Line x:Name="Drop7" X1="0" Y1="0" X2="-4" Y2="14" Stroke="#88A8C5D6" StrokeThickness="1" Canvas.Left="45" Canvas.Top="-14"/>
                        <Line x:Name="Drop8" X1="0" Y1="0" X2="-4" Y2="14" Stroke="#77A8C5D6" StrokeThickness="1" Canvas.Left="290" Canvas.Top="-14"/>
                    </Canvas>
                </Viewbox>

                <!-- 皮肤 10：星空太空风（深藏蓝夜空渐变） -->
                <Border x:Name="StarrySkinBg" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0A0E27" Offset="0"/>
                            <GradientStop Color="#050711" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#6B7FD7"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#6B7FD7" BlurRadius="12" ShadowDepth="0" Opacity="0.35"/>
                    </Border.Effect>
                </Border>

                <!-- 星空专属：满天星星各自不同步地闪烁 -->
                <Viewbox x:Name="StarryOverlay" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed">
                    <Canvas Width="300" Height="150">
                        <Ellipse x:Name="Star1" Width="2.5" Height="2.5" Fill="#FFFFFFFF" Canvas.Left="25" Canvas.Top="20"/>
                        <Ellipse x:Name="Star2" Width="2" Height="2" Fill="#FFE8E8FF" Canvas.Left="70" Canvas.Top="45"/>
                        <Ellipse x:Name="Star3" Width="3" Height="3" Fill="#FFFFFFFF" Canvas.Left="120" Canvas.Top="15"/>
                        <Ellipse x:Name="Star4" Width="2" Height="2" Fill="#FFC9D6FF" Canvas.Left="160" Canvas.Top="60"/>
                        <Ellipse x:Name="Star5" Width="2.5" Height="2.5" Fill="#FFFFFFFF" Canvas.Left="200" Canvas.Top="30"/>
                        <Ellipse x:Name="Star6" Width="2" Height="2" Fill="#FFE8E8FF" Canvas.Left="240" Canvas.Top="50"/>
                        <Ellipse x:Name="Star7" Width="3" Height="3" Fill="#FFFFFFFF" Canvas.Left="270" Canvas.Top="20"/>
                        <Ellipse x:Name="Star8" Width="2" Height="2" Fill="#FFC9D6FF" Canvas.Left="45" Canvas.Top="70"/>
                    </Canvas>
                </Viewbox>

                <!-- 皮肤 11：篝火露营风（深林绿渐变，暖橙边框） -->
                <Border x:Name="CampfireSkinBg" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A2818" Offset="0"/>
                            <GradientStop Color="#12180F" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#D97B36"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#D97B36" BlurRadius="14" ShadowDepth="0" Opacity="0.45"/>
                    </Border.Effect>
                </Border>

                <!-- 皮肤 12：樱花风（暗调粉紫渐变，柔和不刺眼） -->
                <Border x:Name="SakuraSkinBg" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#3D2A3D" Offset="0"/>
                            <GradientStop Color="#241826" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#F7A8C4"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#F7A8C4" BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
                    </Border.Effect>
                </Border>

                <!-- 樱花专属：花瓣一边飘落一边左右轻摇 -->
                <Viewbox x:Name="SakuraOverlay" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed">
                    <Canvas Width="300" Height="150" ClipToBounds="True">
                        <Ellipse x:Name="Petal1" Width="5" Height="4" Fill="#F7A8C4" Canvas.Left="20" Canvas.Top="-10"/>
                        <Ellipse x:Name="Petal2" Width="4" Height="3" Fill="#F0C4D8" Canvas.Left="80" Canvas.Top="-10"/>
                        <Ellipse x:Name="Petal3" Width="5" Height="4" Fill="#F7A8C4" Canvas.Left="140" Canvas.Top="-10"/>
                        <Ellipse x:Name="Petal4" Width="4" Height="3" Fill="#F0C4D8" Canvas.Left="190" Canvas.Top="-10"/>
                        <Ellipse x:Name="Petal5" Width="5" Height="4" Fill="#F7A8C4" Canvas.Left="240" Canvas.Top="-10"/>
                        <Ellipse x:Name="Petal6" Width="4" Height="3" Fill="#F0C4D8" Canvas.Left="270" Canvas.Top="-10"/>
                    </Canvas>
                </Viewbox>

                <!-- 皮肤 13：复古磁带机风（暖米色塑料机身，是唯一的浅色调皮肤，文字改用深色） -->
                <Border x:Name="CassetteSkinBg" BorderThickness="1" CornerRadius="6" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D9C9A8" Offset="0"/>
                            <GradientStop Color="#B8A488" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#8A6A4A"/>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect Color="#3A2E22" BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                    </Border.Effect>
                </Border>

                <!-- 内容层：所有皮肤共用，只是背景/文字颜色不同（由代码按皮肤设置） -->
                <Grid Margin="12,6,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="RowTitle" Height="Auto"/>
                        <RowDefinition x:Name="RowProgress" Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="TitleRow" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtSongTitle" Text="LOADING..." FontFamily="Lucida Console" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtArtist" Text=" - ARTIST" FontFamily="Lucida Console" Foreground="#DDD" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTime" Text="[00:00 / 00:00]" FontFamily="Lucida Console" Foreground="#DDD" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,6,0,6">
                        <ProgressBar x:Name="LyricProgressBar" Height="6" Background="#111111" Foreground="#55FF55" BorderThickness="1" BorderBrush="#333333" Minimum="0" Maximum="100" Value="0">
                            <ProgressBar.Effect>
                                <DropShadowEffect Color="#55FF55" BlurRadius="5" ShadowDepth="0"/>
                            </ProgressBar.Effect>
                        </ProgressBar>
                    </Grid>

                    <Border x:Name="LyricBox" Grid.Row="2" Background="#D9111111" BorderBrush="#222222" BorderThickness="2" Padding="8,4,8,4">
                        <TextBlock x:Name="TxtDynamicLyric"
                                   Text="📡 LINKING SPICETIFY..."
                                   FontFamily="Lucida Console"
                                   Foreground="#FFFF55"
                                   FontSize="14"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- CRT 皮肤专属：扫描线叠加层，铺在最上面，不拦截鼠标事件 -->
                <Border x:Name="ScanlineOverlay" IsHitTestVisible="False" Visibility="Collapsed"
                        RenderOptions.BitmapScalingMode="NearestNeighbor" ClipToBounds="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ScanlineTransform" Y="0"/>
                    </Border.RenderTransform>
                    <Border.Background>
                        <ImageBrush x:Name="ScanlineBrush" TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Stretch="Fill"/>
                    </Border.Background>
                </Border>
            </Grid>
        </Grid>

        <ResizeGrip x:Name="WindowResizeGrip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Opacity="0.5" Margin="2"/>

        <!-- 常驻的"返回设置"入口：右键菜单不够显眼，这个齿轮按钮才是主入口 -->
        <Border x:Name="BtnSettings" Width="24" Height="24" CornerRadius="12"
                Background="#99000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"
                Cursor="Hand" ToolTip="更改皮肤 / 设置"
                MouseLeftButtonDown="BtnSettings_MouseLeftButtonDown">
            <TextBlock Text="⚙" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 有新版本时才出现的小徽标：点一下用默认浏览器打开 GitHub Release 页面 -->
        <Border x:Name="UpdateBadge" Visibility="Collapsed" CornerRadius="9" Background="#992E7D32" BorderBrush="#55FF55" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Padding="7,3"
                Cursor="Hand" ToolTip="点击打开发布页下载新版本"
                MouseLeftButtonDown="UpdateBadge_MouseLeftButtonDown">
            <TextBlock x:Name="TxtUpdateBadge" Text="🎉 新版本" FontSize="10" Foreground="White" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
