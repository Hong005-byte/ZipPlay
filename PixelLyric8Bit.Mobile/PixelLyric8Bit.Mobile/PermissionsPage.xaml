<Page x:Class="PixelLyric8Bit.Mobile.PermissionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PixelLyric8Bit.Mobile"
      Background="#0D0D0D">

  <!-- 两块 Android 专属能力的验证区，见 PermissionsPage.xaml.cs 顶部说明——跟正式产品的设置页
       不是一回事，纯粹是"这两个权限能不能申请到、申请到之后悬浮窗能不能用"的调试面板。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="24">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Button Content="‹ 返回" Click="BtnBack_Click" Margin="0,0,12,0"/>
        <TextBlock Text="🔔 权限与悬浮窗" FontFamily="Consolas" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock x:Name="TxtMediaSessionStatus" Text="通知使用权：检查中…" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13" TextWrapping="Wrap"/>
      <Button x:Name="BtnOpenNotificationSettings" Content="去开启「通知使用权」" Click="BtnOpenNotificationSettings_Click" Margin="0,6,0,0" HorizontalAlignment="Left"/>

      <TextBlock x:Name="TxtOverlayStatus" Text="悬浮窗权限：检查中…" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="BtnOpenOverlaySettings" Content="去开启「悬浮窗权限」" Click="BtnOpenOverlaySettings_Click" Margin="0,0,8,0"/>
        <Button x:Name="BtnToggleOverlay" Content="显示悬浮窗" Click="BtnToggleOverlay_Click"/>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
