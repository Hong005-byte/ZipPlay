<Page x:Class="PixelLyric8Bit.Mobile.CustomThemePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PixelLyric8Bit.Mobile"
      Background="#0D0D0D">

  <!-- 自定义主题——精简版：只吃 JSON（跟桌面版自定义主题页同一份格式，能直接互通），见
       CustomThemePage.xaml.cs 顶部说明 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="24">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Button Content="‹ 返回" Click="BtnBack_Click" Margin="0,0,12,0"/>
        <TextBlock Text="🖌️ 自定义主题" FontFamily="Consolas" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- 卡片容器——按功能分区拆成几张卡片（预览 / JSON 编辑与已存列表 / 分享码 / 文件导入导出），
           见 PermissionsPage.xaml 同处注释；PreviewCard/IconZoomCard 本身的颜色是跟着当前编辑的主题
           程序动态算出来的（见 UpdatePreview），外面这层卡片只是给这一整块区域一个统一的容器色，
           两层颜色来源不一样，套在一起不冲突 -->
      <Border Background="#141414" BorderBrush="#262626" BorderThickness="1" CornerRadius="14" Padding="18">
        <StackPanel>
          <!-- 实时预览——照着悬浮窗真实会画出来的样子来（背景/边框/图标含逐帧动画/文字色），不是桌面版
               那张完整播放器卡片；JSON 一改（TxtCustomThemeJson_TextChanged）立刻重画，校验没过就隐藏
               换成下面这行提示，不在这里报具体错误，具体错误还是走"校验并保存"那条路，见
               CustomThemePage.xaml.cs 的 UpdatePreview 说明 -->
          <TextBlock Text="实时预览" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13"/>
          <Border x:Name="PreviewCard" CornerRadius="14" BorderThickness="2" Padding="14,10" MinHeight="60" Margin="0,6,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image x:Name="PreviewIcon" Width="40" Height="40" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="PreviewText" Text="ZipPlay 预览歌词" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="TxtPreviewHint" Text="预览：JSON 还没校验通过，改好格式会自动出现" FontFamily="Consolas" Foreground="#666666" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>

          <!-- 图标细节放大——跟 PreviewIcon 共用同一批渲染出来的位图（不是重新画一遍），原图直接放大显示、
               不做模糊处理，方格开大了也看得清哪一格是什么颜色；有 icon.frames 的话跟主预览同步播放同一帧，
               见 UpdatePreview/ApplyPreviewTheme。JSON 没校验通过就跟主预览一起隐藏 -->
          <TextBlock Text="图标细节放大" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13" Margin="0,14,0,0"/>
          <Border x:Name="IconZoomCard" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" Padding="10"
                  HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed">
            <Image x:Name="IconZoomPreview" Stretch="Uniform" MaxWidth="220" MaxHeight="220"/>
          </Border>
        </StackPanel>
      </Border>

      <Border Background="#141414" BorderBrush="#262626" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
        <StackPanel>
          <TextBox x:Name="TxtCustomThemeJson" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"
                   Height="140" Background="#1A1A1A" Foreground="White" TextChanged="TxtCustomThemeJson_TextChanged"/>
          <!-- 真机验证过：三个按钮硬排一行在窄屏上会被卡片内缩的宽度顶出屏幕右边（"删除当前选中"
               最后几个字被裁掉）——先试过在外面套一层横向 ScrollViewer，真机上发现 Uno 这个版本对
               "StackPanel 里嵌一个横向 ScrollViewer、外层又是纵向 ScrollViewer" 这种嵌套没有正确裁剪
               视口（内容照样溢出到卡片外面，横向拖拽也滑不动），干脆改成拆两行摆——第一行两个按钮
               已经验证正好占满不溢出，"删除当前选中" 单独一行，不用再赌 ScrollViewer 在这个渲染管线
               上到底通不通 -->
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="校验并保存" Click="BtnSaveCustomTheme_Click" Margin="0,0,8,0"/>
            <Button Content="填入示例" Click="BtnFillExampleTheme_Click"/>
          </StackPanel>
          <Button Content="删除当前选中" Click="BtnDeleteCustomTheme_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
          <Button Content="🖌️ 打开图标画板" Click="BtnOpenIconPainter_Click" Margin="0,8,0,0" HorizontalAlignment="Left"/>
          <TextBlock x:Name="TxtCustomThemeError" FontFamily="Consolas" Foreground="#FF8080" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
            <StackPanel x:Name="CustomThemePickerPanel" Orientation="Horizontal"/>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- 🔗 分享码：当前编辑框里这份 JSON 校验通过才能生成，压成一段带识别前缀的纯文本，
           聊天框里发一行字就行，不用像导出文件那样对方还得找地方存；导入是反过来，从剪贴板读一段
           分享码解出 JSON 塞回编辑框，见 BtnCopyShareCode_Click / BtnImportShareCode_Click -->
      <Border Background="#141414" BorderBrush="#262626" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="🔗 主题分享码（复制/粘贴一段文字分享，不用发文件）" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="复制分享码" Click="BtnCopyShareCode_Click" Margin="0,0,8,0"/>
            <Button Content="粘贴分享码导入" Click="BtnImportShareCode_Click"/>
          </StackPanel>
          <TextBlock x:Name="TxtShareCodeStatus" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>

      <!-- 导入 / 导出成文件——系统的文件选择器，能存到手机任意位置或者从任意位置读，发给别人/收别人
           发来的文件都是走这条路，见 BtnExportFile_Click / BtnImportFile_Click -->
      <Border Background="#141414" BorderBrush="#262626" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="导入 / 导出成文件" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button Content="📤 导出到文件" Click="BtnExportFile_Click" Margin="0,0,8,0"/>
            <Button Content="📥 从文件导入" Click="BtnImportFile_Click"/>
          </StackPanel>
          <TextBlock x:Name="TxtFileIoStatus" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
