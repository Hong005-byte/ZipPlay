<Page x:Class="PixelLyric8Bit.Mobile.SkinPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PixelLyric8Bit.Mobile"
      Background="#0D0D0D">

  <!-- 悬浮窗皮肤选择——见 SkinPage.xaml.cs 顶部说明 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Padding="24">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
        <Button Content="‹ 返回" Click="BtnBack_Click" Margin="0,0,12,0"/>
        <TextBlock Text="🎨 悬浮窗皮肤" FontFamily="Consolas" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock x:Name="TxtCurrentSkin" Text="悬浮窗皮肤：简约风" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13"/>
      <!-- 竖着一条条往下排——外层 Page 本来就包了一层纵向 ScrollViewer，皮肤够多的话跟着整页一起往下
           滚，不用再单独套一层横向 ScrollViewer -->
      <StackPanel x:Name="SkinPickerPanel" Orientation="Vertical" Margin="0,6,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Page>
