<Page x:Class="PixelLyric8Bit.Mobile.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:PixelLyric8Bit.Mobile"
      Background="#0D0D0D">

  <!-- 首页——只是一份功能清单 + 示例歌词预览，具体内容都在各自独立的页面里（PermissionsPage /
       SkinPage / LyricFeaturesPage / StatsPage / CustomThemePage），点按钮用 Frame.Navigate 真的
       跳过去，不是在这一页里展开/收起（那是上一版的做法，见这几个 Btn*_Click）。跟桌面版首页 Hub
       的便当格是同一个用意：先看到一份功能清单，点进去才看到具体内容，只是那边是真的多个窗口，
       这边是同一个 Frame 里的多个 Page，靠 Frame 自带的返回栈"退回去"，各子页面顶部都有一个
       "‹ 返回" 按钮调 Frame.GoBack()。 -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Padding="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
        <!-- 跟桌面版 PixelArt.CreateNoteIcon 同一个形状/配色的像素音符图标——渲染代码没法共享
             （WPF 和 Uno 各自的 WriteableBitmap 是不同图形栈的类型），但"画出来长什么样"这份设计
             是共享的，两边看到的是同一个图标，见 PixelIconRenderer.cs 的说明 -->
        <Image x:Name="AppIcon" Width="48" Height="48" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtSongTitle" Text="ZipPlay Mobile" FontFamily="Consolas" Foreground="White" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="TxtArtist" Text=" 悬浮歌词骨架" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13" Margin="8,5,0,0" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- 五个功能入口——每个都是独立页面，见各自 .xaml(.cs) 顶部说明 -->
      <StackPanel Grid.Row="1" Margin="0,0,0,16">
        <Button Content="🔔 权限与悬浮窗" Click="BtnNavPermissions_Click" Margin="0,0,0,10"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
        <Button Content="🎨 悬浮窗皮肤" Click="BtnNavSkin_Click" Margin="0,0,0,10"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
        <Button Content="🎤 歌词功能设置" Click="BtnNavLyricFeatures_Click" Margin="0,0,0,10"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
        <Button Content="📊 听歌统计与成就" Click="BtnNavStats_Click" Margin="0,0,0,10"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
        <Button Content="🖌️ 自定义主题" Click="BtnNavCustomTheme_Click"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
      </StackPanel>

      <!-- 示例歌词预览——骨架阶段唯一留在首页的"内容"，不是设置项，收进某个子页面里反而奇怪 -->
      <Border Grid.Row="2" Background="#D9111111" BorderBrush="#222222" BorderThickness="2" Padding="16" MinHeight="120"
              VerticalAlignment="Center" CornerRadius="8">
        <TextBlock x:Name="TxtDynamicLyric" Text="LOADING..." FontFamily="Consolas" Foreground="#FFFF55" FontSize="22"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
      </Border>
    </Grid>
  </ScrollViewer>
</Page>
